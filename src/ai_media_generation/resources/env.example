# ACE-Step REST API base URL. Leave empty when the API is not running.
ACE_STEP_URL=http://127.0.0.1:8001

# ACE-Step API key. Leave empty when the server has no ACESTEP_API_KEY.
ACE_STEP_API_KEY=

# Prefix for saved audio filenames. Spec id is appended.
ACE_STEP_FILENAME_PREFIX=music

# Root directory for feature input folders (lora-training/, prompt/, music/).
# Used when LORA_TRAINING_DIRECTORY, PROMPT_DIRECTORY, or MUSIC_DIRECTORY is unset.
INPUT_DIRECTORY=ai-media-generation

# LoRA training JSON (art-style.json, characters/, ...). Defaults to INPUT_DIRECTORY/lora-training.
LORA_TRAINING_DIRECTORY=

# Prompt JSON for image. Nested folders allowed. Defaults to INPUT_DIRECTORY/prompt.
PROMPT_DIRECTORY=

# Music JSON for music. Defaults to INPUT_DIRECTORY/music.
MUSIC_DIRECTORY=

# ComfyUI base URL (--listen default).
COMFY_UI_URL=http://127.0.0.1:8188

# Checkpoint filename in ComfyUI's models/checkpoints directory.
COMFY_UI_CKPT_NAME=animagine-xl-4.0-opt.safetensors

# Prefix for saved image filenames. Row number and tags are appended.
COMFY_UI_FILENAME_PREFIX=lora

# Directory for fetched images and .txt captions.
# Defaults to output when unset.
OUTPUT_DIRECTORY=output
