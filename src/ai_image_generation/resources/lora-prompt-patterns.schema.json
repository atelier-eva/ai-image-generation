{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.spec/lora/lora-prompt-patterns.schema.json",
  "title": "LoRA prompt patterns (lora-prompt-patterns.json)",
  "description": "Prompt tag definitions for camera, expression, and character combinations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "angle": {
          "type": "array",
          "items": { "$ref": "#/$defs/namedTagSet" }
        },
        "distance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "image_size"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Stable identifier; used in filename_prefix. When positive is omitted or empty, name is the sole positive tag."
              },
              "positive": { "$ref": "#/$defs/tags" },
              "negative": { "$ref": "#/$defs/tags" },
              "image_size": {
                "type": "object",
                "additionalProperties": false,
                "required": ["width", "height"],
                "properties": {
                  "width": { "type": "integer" },
                  "height": { "type": "integer" }
                },
                "description": "Output dimensions for this camera distance (width x height)"
              }
            }
          }
        }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skip_camera": {
          "$ref": "#/$defs/skip_camera",
          "description": "When angle or distance name matches (OR), emit one row per character without expression tags instead of iterating expression.patterns."
        },
        "patterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/namedTagSet" }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name used in filename_prefix and caption_prompt"
          },
          "subject": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/$defs/tags" }
            ],
            "description": "Subject tags emitted first in positive_prompt only (e.g. 1girl); omitted from caption_prompt"
          },
          "positive": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["tag"],
                  "properties": {
                    "tag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "weight": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "Attention weight for positive_prompt only (emitted as (tag:weight)); caption_prompt uses the bare tag"
                    },
                    "skip_camera": {
                      "$ref": "#/$defs/skip_camera",
                      "description": "When angle or distance name matches (OR), this tag is omitted."
                    }
                  }
                }
              ]
            }
          },
          "negative": { "$ref": "#/$defs/tags" }
        }
      }
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "skip_camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "angle": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "camera.angle[].name values"
        },
        "distance": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "camera.distance[].name values"
        }
      }
    },
    "namedTagSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier; used in filename_prefix. When positive is omitted or empty, name is the sole positive tag."
        },
        "positive": { "$ref": "#/$defs/tags" },
        "negative": { "$ref": "#/$defs/tags" }
      }
    }
  }
}
