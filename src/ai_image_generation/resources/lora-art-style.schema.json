{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.spec/lora/lora-art-style.schema.json",
  "title": "LoRA art style (lora-art-style.json)",
  "description": "Art style, quality, and rating tags for generated prompts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "art_style": { "$ref": "#/$defs/tagSet" },
    "quality": { "$ref": "#/$defs/tagSet" },
    "rating": { "$ref": "#/$defs/tagSet" }
  },
  "$defs": {
    "tagSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "negative": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
