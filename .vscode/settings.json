  "files.exclude": {
    "**/__pycache__": true,
    "**/*.py[cod]": true,
    "**/*.egg-info": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    ".venv": true
  },
